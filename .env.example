# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword123

# LLM — pick a backend; prompts and validation are identical on all three.
#   api           -> Anthropic SDK, set ANTHROPIC_API_KEY
#   openai_compat -> any OpenAI-protocol provider (OpenAI, Gemini, Mistral,
#                    Groq, local Ollama, Anthropic's compat endpoint):
#                    set LLM_API_KEY, LLM_BASE_URL, and a matching LLM_MODEL
#   claude_cli    -> locally-installed, logged-in Claude Code CLI; no key
LLM_BACKEND=api
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5
# openai_compat example (OpenAI):
#   LLM_BACKEND=openai_compat
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o

# Target app
TARGET_APP_BASE_URL=https://app.cal.com
TARGET_APP_EMAIL=your-test-account@example.com
TARGET_APP_PASSWORD=your-test-password

# Target repo (cloned locally for the code-mapping + PR stages)
TARGET_REPO_PATH=./data/cal.com
TARGET_PR_NUMBER=12345

# GitHub repo slug for PR fetch (the sample graph was built against calcom/cal.diy)
TARGET_REPO_SLUG=calcom/cal.com
# Optional: raises GitHub API rate limits for PR fetch
GITHUB_TOKEN=
