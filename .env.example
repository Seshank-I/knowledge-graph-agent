# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword123

# LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5

# Target app
TARGET_APP_BASE_URL=https://app.cal.com
TARGET_APP_EMAIL=your-test-account@example.com
TARGET_APP_PASSWORD=your-test-password

# Target repo (cloned locally for the code-mapping + PR stages)
TARGET_REPO_PATH=./data/cal.com
TARGET_PR_NUMBER=12345

# GitHub repo slug for PR fetch (the sample graph was built against calcom/cal.diy)
TARGET_REPO_SLUG=calcom/cal.com
# Optional: raises GitHub API rate limits for PR fetch
GITHUB_TOKEN=
